# Copy to .env and uncomment to override where the app finds
# PottersInventoryServer. Leave unset to auto-detect when running in
# Expo Go on the same Wi-Fi as the dev machine (see src/config.ts).

# Full server URL - required with `npm run start:tunnel`, e.g. a
# cloudflared tunnel URL or a deployed server.
# EXPO_PUBLIC_API_URL=https://your-tunnel.trycloudflare.com

# Only used for auto-detection, if the server isn't on 8080.
# EXPO_PUBLIC_API_PORT=8080
