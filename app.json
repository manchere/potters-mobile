{
  "expo": {
    "name": "Potters Portal",
    "slug": "potters-portal-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "pottersportal",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph items and scan barcodes for the inventory."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b1a33"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Potters Portal to use the camera to photograph items and scan barcodes."
        }
      ],
      "expo-asset"
    ],
    "icon": "./assets/icon.png",
    "backgroundColor": "#0b1a33",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1a33"
    }
  }
}
